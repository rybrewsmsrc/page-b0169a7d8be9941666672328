-bottom:2px solid var(--deep);margin-bottom:1.25rem;display:flex;align-items:baseline;gap:.7rem}\n  .faq-group h3 .letter{font-size:.76rem;letter-spacing:.18em;color:var(--amber)}\n  .qa-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.6rem 3rem}\n  .qa h4{font-size:.95rem;margin:0 0 .35rem;line-height:1.55}\n  .qa p{font-size:.9rem;color:var(--ink-soft)}\n\n  footer{background:var(--deep);color:rgba(246,244,239,.7);margin-top:1rem}\n  .foot-inner{max-width:1120px;margin:0 auto;padding:2.5rem 1.25rem 3rem;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1.5rem 3rem;font-size:.84rem}\n  .foot-inner .brandline{color:var(--paper);font-size:1rem;letter-spacing:.18em;margin-bottom:.5rem}\n  .foot-inner nav{display:flex;flex-wrap:wrap;gap:.4rem 1.25rem;align-content:start}\n  .foot-inner nav a{color:rgba(246,244,239,.72);text-decoration:none;border-bottom:1px solid transparent;padding-bottom:2px}\n  .foot-inner nav a:hover{color:var(--amber-soft);border-bottom-color:var(--amber)}\n  .foot-inner .fine{grid-column:1 / -1;padding-top:1.25rem;border-top:1px solid var(--line-light);color:rgba(246,244,239,.5);font-size:.78rem}\n\n  @media (max-width:860px){\n    .hero-inner{grid-template-columns:1fr;gap:2rem}\n    .hero-panel{grid-template-columns:1fr 1fr}\n    .band-head{grid-template-columns:1fr;gap:.5rem}\n    .band-head .sub{grid-column:1}\n    .steps{grid-template-columns:1fr;gap:1.85rem}\n    .plans{grid-template-columns:1fr;gap:2.25rem}\n    .plan:nth-child(2),\n    .plan:nth-child(3){padding-top:0}\n    .clients{grid-template-columns:1fr}\n    .qa-grid{grid-template-columns:1fr;gap:1.35rem}\n    .foot-inner{grid-template-columns:1fr}\n  }\n  @media (max-width:520px){\n    .topbar nav{gap:.75rem;font-size:.74rem;letter-spacing:.03em}\n    .hero-panel{grid-template-columns:1fr}\n    .client{grid-template-columns:1fr;gap:.5rem}\n  }\n</style><header class=\"topbar\">\n  <div class=\"topbar-inner\">\n    <div class=\"mark\">布吉<span>岛</span></div>\n    <nav aria-label=\"页面目录\">\n      <a href=\"#how\">使用说明</a>\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n  </div>\n</header>\n\n<section class=\"hero\">\n  <div class=\"hero-inner\">\n    <div class=\"hero-kicker\">\n      <span>布吉岛 · 订阅说明</span>\n      <span class=\"rule\"></span>\n      <span>第 01 版</span>\n    </div>\n    <div class=\"hero-stack\">\n      <h1>布吉岛：把订阅的<em>条款</em>说清楚，比说好听更重要。</h1>\n      <p class=\"hero-lede\">这是一份写给使用者的说明书。你会在下面看到三个方案的价格、流量与设备数量，看到下单之后具体该做什么，也会看到我们目前无法承诺的部分。我们不使用形容词来替代数字。</p>\n      <blockquote class=\"hero-quote\">\n        阅读顺序建议：先看使用说明，确认你的设备和用途；再看方案对比，选择容量与在线数量的档位；最后浏览常见问题，避免重复咨询。\n        布吉岛 编辑组\n      </blockquote>\n    </div>\n    <div class=\"hero-panel\">\n      <div>\n        <dl>\n          <dt>方案数量</dt>\n          <dd>3 档，按流量与设备数区分</dd>\n        </dl>\n      </div>\n      <div>\n        <dl>\n          <dt>计费方式</dt>\n          <dd>按月付或年付</dd>\n        </dl>\n      </div>\n      <div>\n        <dl>\n          <dt>在线设备</dt>\n          <dd>3 / 5 / 20 台，对应三档</dd>\n        </dl>\n      </div>\n      <div>\n        <dl>\n          <dt>当前状态</dt>\n          <dd>页面信息以此处版本为准</dd>\n        </dl>\n      </div>\n    </div>\n  </div>\n</section>\n\n<main>\n\n  <section class=\"band\" id=\"how\">\n    <div class=\"band-head\">\n      <p class=\"index\">01 — 使用说明</p>\n      <h2 id=\"how-title\">从确认需求到开始使用</h2>\n      <p class=\"sub\">以下步骤按实际发生顺序排列。每一步都写明了你需要准备什么、以及可能卡住的地方。先读完再动手，通常比边点边问更省时间。</p>\n    </div>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <h3><span class=\"num\">01</span>先确认你的用途</h3>\n        <p>把日常用途分成三类：只是浏览网页与查看文档、需要看流媒体、需要多台设备同时在线。用途决定你应该看流量数字还是看设备数量。</p>\n        <ul>\n          <li>单人日常使用，重点看流量额度。</li>\n          <li>家庭或小团队，重点看同时在线设备数。</li>\n          <li>有明确的线路要求，请先咨询再下单。</li>\n        </ul>\n      </div>\n\n      <div class=\"step\">\n        <h3><span class=\"num\">02</span>核对设备与环境</h3>\n        <p>确认你将使用的终端类型与操作系统版本，并保证系统时间与网络正常。多数连不上问题来自本地环境，而不是方案本身。</p>\n        <ul>\n          <li>记录设备型号与系统版本，便于后续排查。</li>\n          <li>关闭可能干扰网络连接的本地代理或防火墙规则。</li>\n          <li>保留一份能正常访问网络的备用方式。</li>\n        </ul>\n      </div>\n\n      <div class=\"step\">\n        <h3><span class=\"num\">03</span>选择档位并核对条款</h3>\n        <p>在下方方案区对照流量、在线设备数与年付价格。年付是按年一次性结算，折算到每月更低的数字仅代表计价方式差异，不代表服务内容变化。</p>\n        <ul>\n          <li>确认月付与年付的差价是否值得提前支付。</li>\n          <li>确认流量额度是否覆盖你的月度峰值。</li>\n          <li>确认设备数量上限是否包含你所有终端。</li>\n        </ul>\n      </div>\n\n      <div class=\"step\">\n        <h3><span class=\"num\">04</span>配置并验证</h3>\n        <p>按你所用客户端的方式完成配置，然后做一次基础验证：打开常用网站、检查页面能否正常加载、确认设备数量未超限。</p>\n        <ul>\n          <li>先在一台设备上验证，再扩展到其他设备。</li>\n          <li>若多项设置同时修改，逐项回退以便定位问题。</li>\n          <li>记录出错时的提示文字，咨询时一并提供。</li>\n        </ul>\n      </div>\n    </div>\n\n    <p class=\"note\"><strong>说明：</strong>本页仅陈述方案结构与操作顺序，不承诺任何具体速度、节点分布、线路质量或可用地区。若你的使用场景对上述指标有硬性要求，请先咨询后再决定是否订阅。</p>\n  </section>\n\n  <section class=\"band\" id=\"plans\">\n    <div class=\"band-head\">\n      <p class=\"index\">02 — 订阅方案</p>\n      <h2 id=\"plans-title\">三档方案，按容量递进排列</h2>\n      <p class=\"sub\">从下往上看，价格、流量与在线设备数同步增加。每一档只列出可核对的条目，不做修饰。</p>\n    </div>\n\n    <div class=\"plans\">\n      <article class=\"plan\">\n        <p class=\"tier\"><span class=\"bar\"></span>第一档</p>\n        <h3>基础版</h3>\n        <p class=\"price\">¥15<small>/ 月</small></p>\n        <p class=\"annual\">按年付仅需 ¥150 / 年</p>\n        <ul>\n          <li>每月 100GB 流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>基础流媒体解锁</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <p class=\"tier\"><span class=\"bar\"></span>第二档</p>\n        <h3>旗舰版</h3>\n        <p class=\"price\">¥35<small>/ 月</small></p>\n        <p class=\"annual\">按年付仅需 ¥350 / 年</p>\n        <p class=\"featured\">多数个人使用者选此档</p>\n        <ul>\n          <li>每月 300GB 流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7×24 优先工单支持</li>\n        </ul>\n      </article>\n\n      <article class=\"plan\">\n        <p class=\"tier\"><span class=\"bar\"></span>第三档</p>\n        <h3>团队版</h3>\n        <p class=\"price\">¥85<small>/ 月</small></p>\n        <p class=\"annual\">按年付仅需 ¥850 / 年</p>\n        <ul>\n          <li>每月 1000GB 流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </article>\n    </div>\n\n    <p class=\"plans-foot\">价格与权益以本节列出的条目为准。年付金额为一次性支付，折算每月价格仅用于横向比较。流量按月计算，未提及的结转规则不在本页承诺范围内。</p>\n  </section>\n\n  <section class=\"band\" id=\"clients\">\n    <div class=\"band-head\">\n      <p class=\"index\">03 — 客户端</p>\n      <h2 id=\"clients-title\">按平台说明，不提供未经核实的下载地址</h2>\n      <p class=\"sub\">下方按终端类型分组说明。由于目前没有可确认的官方下载来源，本页不放置任何下载链接，避免将你引导至错误安装包。</p>\n    </div>\n\n    <div class=\"clients\">\n      <div class=\"client\">\n        <p class=\"tag\">桌面</p>\n        <div>\n          <h3>桌面系统客户端</h3>\n          <p>在桌面系统中，客户端通常包含连接开关、配置导入与状态显示三部分。建议先在一台设备上完成导入并验证，再同步到其他桌面设备。</p>\n          <p class=\"status\">下载地址：待确认，本页不提供</p>\n        </div>\n      </div>\n\n      <div class=\"client\">\n        <p class=\"tag\">移动</p>\n        <div>\n          <h3>移动端客户端</h3>\n          <p>移动端切换网络频繁，建议在稳定网络下完成配置，并留意系统对后台运行的限制。设备数量上限按同时在线计算，离线设备不占用额度。</p>\n          <p class=\"status\">下载地址：待确认，本页不提供</p>\n        </div>\n      </div>\n\n      <div class=\"client\">\n        <p class=\"tag\">路由</p>\n        <div>\n          <h3>路由器与家庭网络</h3>\n          <p>把配置放在路由器上可覆盖家中多台设备，但会集中占用在线设备额度。若你的方案设备数较少，不建议采用此方式。</p>\n          <p class=\"status\">下载地址：待确认，本页不提供</p>\n        </div>\n      </div>\n\n      <div class=\"client\">\n        <p class=\"tag\">通用</p>\n        <div>\n          <h3>配置信息与手工导入</h3>\n          <p>若客户端支持手工导入，请以你收到的配置信息为准，逐项核对字段后再保存。不要使用来源不明的第三方配置文件。</p>\n          <p class=\"status\">配置来源：以你获得的配置信息为准</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band\" id=\"faq\">\n    <div class=\"band-head\">\n      <p class=\"index\">04 — 常见问题</p>\n      <h2 id=\"faq-title\">按主题分组的问答</h2>\n      <p class=\"sub\">问题按主题归为三组：订阅与计费、使用与设备、支持与限制。每组只回答本页能够确认的内容。</p>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3><span class=\"letter\">A</span>订阅与计费</h3>\n      <div class=\"qa-grid\">\n        <div class=\"qa\">\n          <h4>月付和年付的服务内容有区别吗？</h4>\n          <p>没有。年付只是把 12 个月的费用一次性结算，价格折算后低于按月支付。你在方案区看到的流量与设备数量，两种付法一致。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>我可以中途从月付改为年付吗？</h4>\n          <p>本页不描述变更流程，也不承诺折算或抵扣规则。若你有此需求，请在下单前先咨询，并以对方给出的答复为准。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>流量用完了会怎样？</h4>\n          <p>本页只列出各档的每月流量额度，不说明超出后的处理方式。请把额度当作选择档位的依据，而不是当作可透支的配额。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>团队版和旗舰版的差别在哪里？</h4>\n          <p>主要在容量与协同能力：团队版流量为 1000GB、在线设备 20 台，并提供企业定制路由与专属客户经理；旗舰版为 300GB 与 5 台。</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3><span class=\"letter\">B</span>使用与设备</h3>\n      <div class=\"qa-grid\">\n        <div class=\"qa\">\n          <h4>在线设备数是怎么计算的？</h4>\n          <p>按同一时间正在使用的设备数量计算。关闭连接或离线的设备不占用额度，因此你可以在多台设备上轮流使用。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>先在哪些设备上配置比较稳妥？</h4>\n          <p>建议先在一台主力设备上完成配置与验证，确认无误后再扩展到第二台。这样一旦出现问题，你能快速判断是配置错误还是额度已满。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>为什么本页没有下载链接？</h4>\n          <p>因为我们目前没有可确认的官方下载来源。放置无法核实的地址可能让你安装到错误文件，所以本页只说明客户端的用途与注意事项。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>路由器上配置会不会占用更多额度？</h4>\n          <p>路由器本身是一台设备，但它会让家中其他终端也走上同一条连接。若你的方案设备数较少，建议先用单台设备验证，再考虑路由器方案。</p>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"faq-group\">\n      <h3><span class=\"letter\">C</span>支持与限制</h3>\n      <div class=\"qa-grid\">\n        <div class=\"qa\">\n          <h4>遇到问题需要提供什么信息？</h4>\n          <p>请准备：设备型号与系统版本、所用方案的名称、出现问题的时间、页面上显示的提示文字。信息完整可以显著减少来回确认的次数。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>旗舰版的优先支持包含什么？</h4>\n          <p>方案区列明为 7×24 优先工单支持。本页不描述具体响应时长，也不承诺解决时间，请以实际工单往来为准。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>你们能保证我需要的地区可用吗？</h4>\n          <p>不能。本页不列出节点地区，也不对可用范围作出承诺。若你的使用场景有明确的地区要求，请在下单前直接咨询。</p>\n        </div>\n        <div class=\"qa\">\n          <h4>本页信息与别处不一致时以哪个为准？</h4>\n          <p>以本页列出的价格、流量与设备数量条目为参考，并在下单前与你实际看到的条款核对。若两者不同，请先咨询再付款。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"foot-inner\">\n    <div>\n      <p class=\"brandline\">布吉岛</p>\n      <p>本页为方案与使用说明，内容按克制的说明书口吻编写，只列出可核对的条目。价格、流量与设备数量如有调整，以你下单时看到的条款为准。</p>\n    </div>\n    <nav aria-label=\"页脚目录\">\n      <a href=\"#how\">使用说明</a>\n      <a href=\"#plans\">订阅方案</a>\n      <a href=\"#clients\">客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n    <p class=\"fine\">本页不提供下载地址、不描述节点分布、不承诺速度与可用地区。相关问题请在下单前咨询确认。</p>\n  </div>\n</footer>",
